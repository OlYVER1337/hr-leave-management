# Copy thành .env rồi đổi giá trị. 
# SQL Server yêu cầu mật khẩu mạnh: >= 8 ký tự, gồm chữ hoa, chữ thường, số, ký tự đặc biệt
SA_PASSWORD=Change_me_Str0ng!
# Khóa ký JWT, tối thiểu 32 ký tự
JWT_KEY=change-this-to-a-long-random-secret-at-least-32-chars
# Bật true để tạo tài khoản HR khởi tạo một lần; dùng giá trị riêng trong .env, không commit mật khẩu
INITIAL_HR_ENABLED=false
INITIAL_HR_EMAIL=
INITIAL_HR_PASSWORD=
INITIAL_HR_FULL_NAME=
INITIAL_HR_CODE=
INITIAL_HR_DEPARTMENT_NAME=HR
ASPNETCORE_ENVIRONMENT=Development
# true/false: bật/tắt Redis cache (dùng khi so sánh Redis ON/OFF)
CACHE_ENABLED=true
