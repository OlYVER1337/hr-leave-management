# Sao chép file này thành .env rồi thay các giá trị mẫu bằng giá trị riêng.
# Không commit .env thật lên Git.

# 1. SQL Server và JWT — bắt buộc
# SQL Server yêu cầu mật khẩu mạnh: tối thiểu 8 ký tự, có chữ hoa, chữ thường,
# chữ số và ký tự đặc biệt.
SA_PASSWORD=Change_me_Str0ng!
# Signing key dùng chung cho HR và Leave; thay bằng chuỗi ngẫu nhiên tối thiểu 32 ký tự.
JWT_KEY=change-this-to-a-long-random-secret-at-least-32-chars

# Môi trường local phát triển để bật Swagger/OpenAPI.
ASPNETCORE_ENVIRONMENT=Development

# Redis catalog cache: true để bật, false để tắt khi benchmark.
CACHE_ENABLED=true

# Frontend: false = dùng HR/Leave API thật; true = dữ liệu demo localStorage.
# Thay đổi giá trị này cần build lại image web.
VITE_DEMO_MODE=false

# 2. Tài khoản HR khởi tạo — bật true khi cần tạo HR trên database mới.
INITIAL_HR_ENABLED=false
INITIAL_HR_EMAIL=
INITIAL_HR_PASSWORD=
INITIAL_HR_FULL_NAME=
INITIAL_HR_CODE=
INITIAL_HR_DEPARTMENT_NAME=HR

# 3. Dữ liệu demo API — bật true để tạo 1 Manager và 1 Employee.
# Manager/Employee được tạo trong HR_DB và dùng để đăng nhập API thật.
DEMO_DATA_ENABLED=false
DEMO_DATA_DEPARTMENT_NAME=Demo
DEMO_DATA_SICK_DAYS_PER_YEAR=10

DEMO_MANAGER_EMAIL=
DEMO_MANAGER_PASSWORD=
DEMO_MANAGER_FULL_NAME=
DEMO_MANAGER_CODE=

DEMO_EMPLOYEE_EMAIL=
DEMO_EMPLOYEE_PASSWORD=
DEMO_EMPLOYEE_FULL_NAME=
DEMO_EMPLOYEE_CODE=
