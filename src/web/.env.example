# Demo mode uses local sample data so the UI can be explored before Leave Service is implemented.
# Set to false after the backend endpoints are available and you want to use real API data.
VITE_DEMO_MODE=true

# Browser-relative API paths; nginx.conf maps these prefixes in the production Docker image.
VITE_HR_API_BASE_URL=/hr-api
VITE_LEAVE_API_BASE_URL=/leave-api

# Optional Vite development proxy targets when running npm run dev outside Docker.
VITE_DEV_HR_TARGET=http://localhost:8081
VITE_DEV_LEAVE_TARGET=http://localhost:8082
