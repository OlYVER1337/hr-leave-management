erDiagram
  LEAVE_REQUESTS ||--o{ LEAVE_REQUEST_HISTORIES : "ghi lịch sử"
  LEAVE_REQUESTS ||--o{ LEAVE_REQUEST_YEAR_ALLOCATIONS : "phân bổ theo năm"
  LEAVE_BALANCES {
    guid Id PK
    guid EmployeeId "HR ID scalar, không cross-DB FK"
    int LeaveTypeId "HR ID scalar, không cross-DB FK"
    int Year
    decimal Entitled
    decimal Used
    decimal Pending
    binary RowVersion
  }
  LEAVE_REQUESTS {
    guid Id PK
    guid EmployeeId "HR ID scalar"
    guid ApproverId "snapshot lúc tạo, không dùng authorize hiện tại"
    int DepartmentId "snapshot lúc tạo"
    int LeaveTypeId "HR ID scalar"
    date StartDate
    date EndDate
    decimal TotalDays
    string Reason
    string Status "Pending, Approved, Rejected, Cancelled"
    datetime CreatedAtUtc
    datetime DecidedAtUtc
    binary RowVersion
  }
  LEAVE_REQUEST_YEAR_ALLOCATIONS {
    guid LeaveRequestId PK,FK
    int Year PK
    decimal Days
  }
  LEAVE_REQUEST_HISTORIES {
    guid Id PK
    guid LeaveRequestId FK
    guid ActorId "HR ID scalar"
    string Action
    string FromStatus
    string ToStatus
    string Note
    datetime CreatedAtUtc
  }
